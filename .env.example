# Discord Developer Portal で発行した Bot Token
DISCORD_BOT_TOKEN=

# Embedを送信する唯一のDiscordチャンネルID
DISCORD_CHANNEL_ID=

# Discord REST APIのベースURL
DISCORD_API_BASE_URL=

# Embedの色（#RRGGBB）
DISCORD_EMBED_COLOR=

# stdio または http
MCP_TRANSPORT=

# MCP_TRANSPORT=httpの場合の待受アドレス
MCP_ADDR=

# MCP_TRANSPORT=http の場合に必須
MCP_BEARER_TOKEN=

# 任意。Embed右上に表示する画像のhttp(s) URL
DISCORD_EMBED_THUMBNAIL_URL=

# Git管理外の投稿ペルソナファイル
MCP_PERSONA_FILE=

# 任意。投稿本文末尾の独立行へ補完する印
MCP_MESSAGE_SUFFIX=
